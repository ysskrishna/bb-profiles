{
  "name": "bb-profiles",
  "version": "0.1.2",
  "type": "module",
  "description": "Choose which providers and models appear in the model picker for each project, and the default model new threads start on.",
  "license": "MIT",
  "author": "YSS Krishna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysskrishna/bb-profiles.git"
  },
  "homepage": "https://github.com/ysskrishna/bb-profiles#readme",
  "bugs": {
    "url": "https://github.com/ysskrishna/bb-profiles/issues"
  },
  "engines": {
    "bb": ">=0.50.1",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Profiles",
    "description": "Choose which providers and models appear in the model picker for each project, and the default model new threads start on.",
    "branding": {
      "icon": "SlidersHorizontal"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts",
    "skills": ["skills"]
  },
  "keywords": ["bb-plugin", "profiles", "models", "model-picker", "providers", "default-model", "custom-models"],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/test-utils.ts",
    "components",
    "lib",
    "skills",
    "app.tsx",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bb plugin build",
    "check": "npm run lint && npm run format:check && npm run knip && npm run typecheck && npm test && npm run test:scripts && npm run build && node scripts/check-app-bundle.mjs",
    "test": "vitest run",
    "test:scripts": "node --test scripts/release/*.test.mjs scripts/e2e/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . && node scripts/check-file-sizes.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip --no-config-hints",
    "prepare": "lefthook install",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "e2e:serve": "node scripts/e2e/serve.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@get-bb/plugin-sdk": "0.6.157",
    "@tanstack/query-core": "5.105.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.50.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.6",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "lefthook": "^2.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
